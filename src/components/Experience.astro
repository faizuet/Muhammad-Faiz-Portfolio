---
import { CenterTitle } from "@components/UI";

const roles = [
    { title: "Backend Software Engineer", company: "NexVolt Solutions", period: "November 2025 – Present", location: "Peshawar, Pakistan", details: ["Deployed and maintained production backend applications on AWS, supporting 1,000+ daily requests with 99% uptime.", "Redesigned PostgreSQL indexes and optimized queries, reducing latency by 94% from 3.2 seconds to 180 milliseconds.", "Automated deployments with Docker and CI/CD, reducing deployment time from hours to minutes.", "Monitored production servers, reviewed logs, and resolved infrastructure and deployment issues on Linux."] },
    { title: "Backend Engineering Intern", company: "Wanclouds Inc.", period: "June 2025 – September 2025", location: "Islamabad, Pakistan", details: ["Developed and maintained backend services with FastAPI and Flask in a cloud product environment.", "Designed relational database schemas and managed MySQL migrations with Alembic.", "Implemented background processing with Celery and Redis.", "Worked with senior engineers to troubleshoot production issues and improve deployment reliability."] },
    { title: "Python Backend Intern", company: "Go Jins", period: "June 2024 – September 2024", location: "Remote", details: ["Implemented JWT authentication and role-based access control, with no unauthorized-access incidents during the internship.", "Added validation, error handling, and retry logic for third-party integrations.", "Standardized request and response formats and API contracts."] },
];
---

<section id="experience" class="w-full py-4 pt-14">
    <CenterTitle title="Professional Experience" color="primary" />
    <div class="experience-list mx-auto max-w-4xl px-4 space-y-5">
        {roles.map((role) => (
            <article class="Fade_Up role-card rounded-xl border border-primaryLiteAlt bg-footerAltLite/60 p-5 md:p-7">
                <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2">
                    <div><h3 class="font-ubuntu text-xl">{role.title}</h3><p class="gradientText">{role.company}</p></div>
                    <p class="text-sm text-center md:text-right">{role.period}<br />{role.location}</p>
                </div>
                <ul class="mt-4 list-disc pl-5 space-y-2">{role.details.map((detail) => <li>{detail}</li>)}</ul>
            </article>
        ))}
    </div>
    <div id="education" class="mx-auto max-w-4xl px-4 pt-10">
        <h3 class="font-ubuntu text-2xl mb-4">Education</h3>
        <article class="Fade_Up surface-card rounded-xl border border-secondaryLiteAlt bg-footerAltLite/60 p-5 md:p-7">
            <h4 class="font-ubuntu text-xl">Bachelor of Science in Computer Science</h4>
            <p>University of Engineering and Technology, Mardan</p>
            <p class="text-sm mt-2">2021 – 2025</p>
            <p class="mt-3 leading-relaxed">Relevant coursework included computer networks, operating systems, cloud computing, computer architecture, and database systems.</p>
        </article>
    </div>
    <div id="certifications" class="mx-auto max-w-4xl px-4 pt-10">
        <h3 class="font-ubuntu text-2xl mb-4">Certifications</h3>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <li class="Fade_Up surface-card rounded-xl border border-secondaryLiteAlt bg-footerAltLite/60 p-5">Backend Engineering Internship Completion — Wanclouds Inc., October 2025</li>
            <li class="Fade_Up surface-card rounded-xl border border-secondaryLiteAlt bg-footerAltLite/60 p-5">Web Developer Internship Completion — Go Jins, September 2024</li>
            <li class="Fade_Up surface-card rounded-xl border border-secondaryLiteAlt bg-footerAltLite/60 p-5">Certificate of Participation, 10-Day Soft Skills Training Program — Pakistan Software Export Board (PSEB), with Liaison Corporation, April 22 – May 2, 2026</li>
        </ul>
    </div>
</section>
