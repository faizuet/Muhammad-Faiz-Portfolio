---
import { SectionTitle, ProjectCard } from "@components/UI";
import { PROJECTS_LIST } from "@/config/ProjectsList";

const PROJECT_LIST_LIMIT = 9;
const visibleProjects = PROJECTS_LIST.filter((project) => !project.isHidden);
const previewProjects = visibleProjects.slice(0, PROJECT_LIST_LIMIT);
---

<section id="projects" class="w-full min-h-screen py-4 pt-14">
    <SectionTitle title="My Projects" color="secondary">
        <!-- Empty Projects Grid -->
        {
            visibleProjects.length === 0 && (
                <p class="text-center mt-10">
                    No projects to display at the moment. Please check back
                    later.
                </p>
            )
        }

        <div
            class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,500px),1fr))] gap-x-6 gap-y-3 mt-4 mb-8"
        >
            {
                previewProjects.map((project) => <ProjectCard project={project} />)
            }
        </div>

        <!-- View all projects -->
        {
            visibleProjects.length > PROJECT_LIST_LIMIT && (
                <a
                    href="/projects"
                    title="View All Projects"
                    class="LinkBtnGradient flex items-center mx-auto w-fit px-5 py-2.5 rounded-lg font-medium"
                >
                    View All Projects
                </a>
            )
        }
    </SectionTitle>
</section>
