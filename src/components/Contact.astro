---
import { CenterTitle } from "@components/UI";
import { GmailIcon } from "@assets/SVGs";
import ContactForm from "@components/Preact/ContactForm";
import { heroConfig } from "@/config/portfolio.config";

---

<section id="contact" class="w-full scroll-mt-16 mb-16 px-4 py-4 pt-14 sm:px-6" aria-labelledby="contact-heading">
    <CenterTitle title="Contact" color="primary" />
    <div class="mx-auto mt-4 max-w-6xl">
        <div class="Fade_Up mb-8 text-center">
            <h2 id="contact-heading" class="gradientText font-ubuntu text-3xl lg:text-4xl">Let's connect</h2>
            <p class="mx-auto mt-3 max-w-2xl text-base leading-relaxed opacity-80">
                For backend, cloud engineering, or collaboration inquiries, reach out by email or connect with me professionally.
            </p>
        </div>

        <div class="grid items-stretch gap-5 lg:grid-cols-[0.85fr_1.15fr] lg:gap-7">
            <aside class="Fade_Up rounded-xl border border-primaryLiteAlt bg-footerAltLite/60 p-5 sm:p-7" aria-label="Contact information">
                <h3 class="font-ubuntu text-xl">Contact details</h3>
                <p class="mt-2 text-sm leading-relaxed opacity-75">I am based in Peshawar, Pakistan and available for professional conversations.</p>

                <div class="mt-6 space-y-3">
                    <a class="group flex min-w-0 items-center gap-3 rounded-lg border border-primaryLiteAlt/70 p-3 transition-colors hover:bg-footerAltLite" href="mailto:faizuet7@gmail.com">
                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-footerAltLite" aria-hidden="true"><GmailIcon class="h-5 w-5" /></span>
                        <span class="min-w-0"><span class="block text-xs opacity-70">Email</span><span class="block break-all text-sm font-medium">faizuet7@gmail.com</span></span>
                    </a>
                    <a class="group flex min-w-0 items-center gap-3 rounded-lg border border-primaryLiteAlt/70 p-3 transition-colors hover:bg-footerAltLite" href="tel:+923258331900">
                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-footerAltLite" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5a2 2 0 0 1 2-2h2.3a1 1 0 0 1 1 .8l.7 3.1a1 1 0 0 1-.5 1.1L8 9.1a12 12 0 0 0 6.9 6.9l1.1-1.5a1 1 0 0 1 1.1-.5l3.1.7a1 1 0 0 1 .8 1V18a2 2 0 0 1-2 2h-1C10.3 20 4 13.7 4 6V5Z"/></svg></span>
                        <span class="min-w-0"><span class="block text-xs opacity-70">Phone</span><span class="block text-sm font-medium">+92 325 8331900</span></span>
                    </a>
                    <div class="flex min-w-0 items-center gap-3 rounded-lg border border-primaryLiteAlt/70 p-3">
                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-footerAltLite" aria-hidden="true">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                        </span>
                        <span><span class="block text-xs opacity-70">Location</span><span class="block text-sm font-medium">Peshawar, Pakistan</span></span>
                    </div>
                </div>

                <div class="mt-6 border-t border-primaryLiteAlt/70 pt-5">
                    <p class="mb-3 text-xs font-medium uppercase tracking-wider opacity-70">Professional profiles</p>
                    <div class="flex flex-wrap gap-3">
                        {heroConfig.links.map((link) => (
                            <a class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-primaryLiteAlt px-4 py-2 text-sm transition-colors hover:bg-footerAltLite focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2" href={link.url} target="_blank" rel="noopener noreferrer" aria-label={`Visit Muhammad Faiz on ${link.label}`}>
                                <span class="inline-flex h-5 w-5 items-center justify-center [&_svg]:h-full [&_svg]:w-full" aria-hidden="true" set:html={link.icon} />
                                <span>{link.label}</span>
                            </a>
                        ))}
                    </div>
                </div>
            </aside>

            <div class="Fade_Up rounded-xl border border-primaryLiteAlt bg-footerAltLite/60 p-4 sm:p-7">
                <div class="mb-4">
                    <h3 class="font-ubuntu text-xl">Send a message</h3>
                    <p class="mt-2 text-sm opacity-75">Fill out the form and I will get back to you.</p>
                </div>
                <ContactForm client:visible />
            </div>
        </div>
    </div>
</section>
