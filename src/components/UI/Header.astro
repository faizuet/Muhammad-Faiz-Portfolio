---
import { Download } from 'lucide-preact';
import ThemeDropdown from '@components/UI/ThemeDropdown.astro';
import ThemeButton from '@components/UI/ThemeButton.astro';

const { config } = Astro.props;

const showThemeDropdown = import.meta.env.PUBLIC_SHOW_THEME_MENU !== 'false';
---

<header id="header" class="hidden lg:block sticky top-0 max-w-[1800px] mx-auto z-50">
    <div
        class="flex justify-between items-center w-full px-6 py-2 headerGradient backdrop-blur-[2px]"
    >
        <a href="#home" class="Fade_Down_Header font-satisfy font-bold text-[1.7em] xl:text-[2em] leading-none whitespace-nowrap shrink-0">
            <span class="gradientText w-fit">{config.logotext}</span>
        </a>

        <nav class="Header_Nav relative tracking-wide flex gap-3 xl:gap-6">
            <a class="Fade_Down_Header" href="#about">ABOUT</a>
            <a class="Fade_Down_Header" href="#skills">SKILLS</a>
            <a class="Fade_Down_Header" href="#experience">EXPERIENCE</a>
            <a class="Fade_Down_Header" href="#projects">PROJECTS</a>
            <a class="Fade_Down_Header" href="#contact">CONTACT</a>
        </nav>

        <div class="flex_center gap-4">
            {showThemeDropdown && <ThemeDropdown className="Fade_Down_Header" idPrefix="Desktop" />}
            <ThemeButton className="Fade_Down_Header" />

            <a
                class="Fade_Down_Header Header_ActionBtn relative overflow-hidden rounded-sm flex_center whitespace-nowrap shrink-0"
                href={config.actionButton.url}
                download="Muhammad-Faiz-Resume.pdf"
            >
                <div class="flex_center gap-2">
                    <p>{config.actionButton.text}</p>
                    <Download size={18} />
                </div>
            </a>
        </div>
    </div>
</header>

<script is:inline type="module">
    const headerElement = document.getElementById('header');

    const sectionsList = {
        '#about': document.getElementById('about'),
        '#skills': document.getElementById('skills'),
        '#experience': document.getElementById('experience'),
        '#projects': document.getElementById('projects'),
        '#contact': document.getElementById('contact'),
    };

    const handleScroll = () => {
        const marker = (headerElement?.offsetHeight || 0) + 64;

        for (const [linkHref, section] of Object.entries(sectionsList)) {
            if (!section) continue;

            const rect = section.getBoundingClientRect();
            const link = document.querySelector(`#header a[href="${linkHref}"]`);

            if (link && headerElement && rect.top <= marker && rect.bottom >= marker) {
                link?.classList.add('active');
            } else {
                link?.classList.remove('active');
            }
        }
    };

    function debounce(func, delay) {
        let timeoutId;
        return function (...args) {
            clearTimeout(timeoutId);
            timeoutId = setTimeout(() => {
                func.apply(this, args);
            }, delay);
        };
    }

    window.addEventListener('scroll', debounce(handleScroll, 0));
    handleScroll();
</script>
