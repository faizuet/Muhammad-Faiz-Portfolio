---
import { CenterTitle, SkillTitle } from "@components/UI";

const groups = [
    { title: "Cloud Platforms", skills: ["AWS EC2", "RDS", "S3", "VPC", "CloudFront", "IAM", "Security Groups"] },
    { title: "Infrastructure", skills: ["Ubuntu Linux", "Docker", "Nginx", "CI/CD", "SSH", "DNS", "SSL/TLS", "TCP/IP"] },
    { title: "Backend & APIs", skills: ["Python", "FastAPI", "Flask", "SQLAlchemy", "Pydantic", "REST APIs", "JWT", "WebSockets"] },
    { title: "Data & Tools", skills: ["PostgreSQL", "MySQL", "SQLite", "SQL", "Redis", "Celery", "Alembic", "Git"] },
];
---

<section id="skills" class="w-full min-h-screen py-4 pt-14">
    <CenterTitle title="Technical Skills" color="primary" />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 px-4 md:px-8">
        {groups.map((group) => (
            <div class="Fade_Up skill-card flex flex-col gap-4 p-4 md:p-6 rounded-xl border border-primaryLiteAlt bg-footerAltLite/60">
                <SkillTitle title={group.title} color="primary" />
                <ul class="flex flex-wrap justify-center gap-3">
                    {group.skills.map((skill) => (
                        <li class="skill-chip rounded-full border border-primaryLiteAlt px-4 py-2 text-sm md:text-base">{skill}</li>
                    ))}
                </ul>
            </div>
        ))}
    </div>
</section>
