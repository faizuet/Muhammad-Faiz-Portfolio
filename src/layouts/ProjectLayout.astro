---
import { SEO } from 'astro-seo';
import { AstroFont } from 'astro-font';
import { join } from 'node:path';
import { Cursor, ProjectsHeader, BackToTop } from '@components/UI';
import { Footer } from '@components/index';

import '@styles/themes.css';
import '@styles/global.css';
import '@styles/cursor.css';

const { title, description, canonical, ogImage, config } = Astro.props;

const canonicalUrl = canonical;
const pageDescription = description || config.site.description;
const pageImage = ogImage || config.site.avatar;

const projectStructuredData = {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description: pageDescription,
    ...(canonicalUrl ? { '@id': `${canonicalUrl}#webpage`, url: canonicalUrl } : {}),
    image: pageImage,
    inLanguage: 'en',
};
---

<!doctype html>
<html lang="en" class=`theme-${config.theme} dark`>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#000" />
        <meta name="robots" content="index, follow" />
        <meta name="keywords" content={config.site.keywords} />
        <meta name="author" content="Muhammad Faiz" />
        <link rel="manifest" href="/manifest.json" />

        <SEO
            title={title}
            description={pageDescription}
            canonical={canonicalUrl ?? null}
            openGraph={canonicalUrl ? {
                basic: {
                    title: `${title}`,
                    type: 'website',
                    image: new URL(pageImage, canonicalUrl).toString(),
                    ...(canonicalUrl ? { url: canonicalUrl } : {}),
                },
            } : undefined}
            twitter={{
                title: `${title}`,
                description: pageDescription,
                card: 'summary',
                ...(canonicalUrl ? { image: new URL(pageImage, canonicalUrl).toString() } : {}),
            }}
            extend={{
                link: [
                    { rel: 'icon', type: 'image/svg+xml', href: '/favicon.svg' },
                    {
                        rel: 'shortcut',
                        type: 'image/svg+xml',
                        href: '/favicon.svg',
                    },
                    {
                        rel: 'apple-touch-icon',
                        type: 'image/svg+xml',
                        href: '/favicon.svg',
                    },
                ],
                meta: canonicalUrl
                    ? [{ name: 'twitter:url', content: canonicalUrl }]
                    : [],
            }}
        />

        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(projectStructuredData)}
        />

        <AstroFont
            config={[
                {
                    name: 'Poppins',
                    src: [
                        {
                            weight: '400',
                            style: 'normal',
                            path: join(
                                process.cwd(),
                                'public',
                                'fonts',
                                'poppins-v20-latin-regular.woff2',
                            ),
                        },
                    ],
                    preload: true,
                    display: 'swap',
                    fallback: 'sans-serif',
                    cssVariable: 'astro-font-poppins',
                    selector: '.font-poppins',
                },
                {
                    name: 'Satisfy',
                    src: [
                        {
                            weight: '400',
                            style: 'normal',
                            path: join(
                                process.cwd(),
                                'public',
                                'fonts',
                                'satisfy-v17-latin-regular.woff2',
                            ),
                        },
                    ],
                    preload: true,
                    display: 'swap',
                    fallback: 'serif',
                    cssVariable: 'astro-font-satisfy',
                    selector: '.font-satisfy',
                },
                {
                    name: 'Ubuntu',
                    src: [
                        {
                            weight: '700',
                            style: 'normal',
                            path: join(
                                process.cwd(),
                                'public',
                                'fonts',
                                'ubuntu-v20-latin-700.woff2',
                            ),
                        },
                    ],
                    preload: true,
                    display: 'swap',
                    fallback: 'serif',
                    cssVariable: 'astro-font-ubuntu',
                    selector: '.font-ubuntu',
                },
            ]}
        />
    </head>
    <body>
        <ProjectsHeader config={config.header} />

        <main class="max-w-450 mx-auto px-6">
            <slot />
        </main>

        <BackToTop />
        <Cursor />
        <Footer config={config.footer} />
        <script src="../script-loader.ts"></script>
    </body>
</html>
