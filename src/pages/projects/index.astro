---
import { SectionTitle, ProjectCard } from '@/components/UI';
import { ProjectLayout } from '@layouts/index';
import { themeConfig, siteConfig, headerConfig, footerConfig } from '@/config/portfolio.config';
import { PROJECTS_LIST } from '@/config/ProjectsList';

const projectsCanonicalUrl = siteConfig.siteUrl ? new URL('projects', siteConfig.siteUrl).toString() : undefined;
const visibleProjects = PROJECTS_LIST.filter((project) => !project.isHidden);
---

<ProjectLayout
    title="Projects | Muhammad Faiz"
    description="Selected backend and cloud projects by Muhammad Faiz."
    canonical={projectsCanonicalUrl}
    config={{
        theme: themeConfig,
        site: siteConfig,
        header: headerConfig,
        footer: footerConfig,
    }}
>
    <SectionTitle title="Projects" color="secondary" className="mb-120">
        <!-- Empty Projects Grid -->
        {
            visibleProjects.length === 0 && (
                <p class="text-center mt-10">
                    No projects to display at the moment. Please check back later.
                </p>
            )
        }

        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,500px),1fr))] gap-x-6 gap-y-3 mt-4">
            {
                visibleProjects.map((project) => <ProjectCard project={project} />)
            }
        </div>
    </SectionTitle>
</ProjectLayout>
