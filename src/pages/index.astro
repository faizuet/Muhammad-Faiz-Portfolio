---
import { Layout } from '@layouts/index';
import { Hero, About, Skills, Experience, Projects, Contact } from '@components/index';
import {
    themeConfig,
    siteConfig,
    headerConfig,
    heroConfig,
    aboutConfig,
    footerConfig,
} from '@/config/portfolio.config';
---

<Layout
    config={{
        theme: themeConfig,
        site: siteConfig,
        header: headerConfig,
        footer: footerConfig,
    }}
>
    <Hero config={heroConfig} />
    <About config={aboutConfig} />
    <Skills />
    <Experience />
    <Projects />
    <Contact />
</Layout>
